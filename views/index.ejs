<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ballon d'Or - Community Awards</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800&family=Playfair+Display:ital,wght@0,600;1,400;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="home-body">

    <%- include('partials/navbar') %>

    <div class="video-hero-container">
        <video class="bg-video" autoplay muted loop playsinline>
            <source src="/videos/ballon.mp4" type="video/mp4">
        </video>

        <div class="video-overlay"></div>

        <div class="hero-content">
            <span class="gold-subtitle">Football Presents</span>
            <h1 class="main-title">Ballon d'Or</h1>
            <p class="hero-quote">
                „History is written by greatness. Tonight, <em>you</em> decide who lifts football's most sacred crown.”
            </p>

            <div class="hero-actions">
                <a href="/voting" class="btn-gold-large">Cast Your Vote (Top 30)</a>
                <a href="/ranking" class="btn-outline-large">View Live Standings</a>
            </div>
        </div>
    </div>

</body>
</html>