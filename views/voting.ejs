<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Voting - Ballon d'Or Ranking</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Styl wyskakującego komunikatu ostrzegawczego */
        .warning-modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.75);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .warning-modal {
            background: #1e1e24;
            border: 2px solid #e5a93c;
            border-radius: 10px;
            padding: 25px 30px;
            max-width: 450px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
        }

        .warning-modal h3 {
            color: #e5a93c;
            margin-top: 0;
            font-size: 1.4rem;
        }

        .warning-modal p {
            color: #ddd;
            margin: 15px 0 20px 0;
            font-size: 1rem;
            line-height: 1.5;
        }

        .modal-close-btn {
            background: #e5a93c;
            color: #000;
            font-weight: bold;
            border: none;
            padding: 8px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.95rem;
        }

        .modal-close-btn:hover {
            background: #f7be58;
        }

        /* Stan zablokowanego przycisku */
        .submit-btn:disabled {
            background: #444;
            color: #888;
            cursor: not-allowed;
            border: 1px solid #555;
        }
    </style>
</head>
<body>

    <%- include('partials/navbar') %>

    <!-- Modal ostrzegawczy -->
    <div class="warning-modal-overlay" id="warningModal">
        <div class="warning-modal">
            <h3>⚠️ Incomplete Ranking!</h3>
            <p id="modalMsg">You must rank all 30 players before submitting your official vote!</p>
            <button type="button" class="modal-close-btn" id="closeModalBtn">Got it!</button>
        </div>
    </div>

    <main class="voting-page-container">
        <h2 class="page-title">Build Your Ballon d'Or Ranking (TOP 30)</h2>
        <p class="page-subtitle">
            Rank <strong>all 30 players</strong> to submit your vote. Drag them into slots or click on any player to assign them.
        </p>

        <form id="rankingForm" action="/vote-ranking" method="POST">
            <input type="hidden" name="rankingOrder" id="rankingOrder">

            <div class="layout-grid">
                <!-- Lewa kolumna ze slotami 1 - 30 -->
                <div class="slots-container">
                    <div class="slots-header">
                        <h3>Ranking Positions</h3>
                        <span id="counter" class="slots-counter">Placed: 0 / 30</span>
                    </div>

                    <div class="slots-grid">
                        <% for(let i = 1; i <= 30; i++) { %>
                            <div class="slot-box" data-slot="<%= i %>">
                                <span class="slot-badge">#<%= i %></span>
                                <div class="slot-target"></div>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Prawa kolumna: Pula piłkarzy -->
                <div class="pool-container">
                    <h3>Available Nominees</h3>
                    <div class="pool-list" id="playersPool">
                        <% players.forEach(player => { %>
                            <div class="player-chip" draggable="true" data-id="<%= player.id %>" title="Drag or click to place">
                                <div class="player-chip-header">
                                    <strong><%= player.name %></strong>
                                    <a href="/player/<%= player.id %>" target="_blank" class="profile-btn" title="View Profile" onclick="event.stopPropagation()">🔍</a>
                                </div>
                                <small><%= player.club %></small>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <div class="vote-footer">
                <button type="button" class="clear-btn" id="resetBtn">Clear All</button>
                <button type="submit" class="submit-btn" id="submitBtn">Submit My Ranking (0/30)</button>
            </div>
        </form>
    </main>

   <script>
        const pool = document.getElementById('playersPool');
        const slots = document.querySelectorAll('.slot-box');
        const form = document.getElementById('rankingForm');
        const rankingInput = document.getElementById('rankingOrder');
        const counter = document.getElementById('counter');
        const resetBtn = document.getElementById('resetBtn');
        const submitBtn = document.getElementById('submitBtn');
        const modal = document.getElementById('warningModal');
        const modalMsg = document.getElementById('modalMsg');
        const closeModalBtn = document.getElementById('closeModalBtn');

        const STORAGE_KEY = 'ballondor_ranking_draft';
        let draggedChip = null;

        function updateCounter() {
            let filled = 0;
            slots.forEach(slot => {
                if (slot.querySelector('.player-chip')) filled++;
            });
            counter.innerText = `Placed: ${filled} / 30`;
            submitBtn.innerText = filled === 30 ? `Submit My Ranking! 🔥` : `Submit My Ranking (${filled}/30)`;
            saveDraftState();
            return filled;
        }

        // Zapis stanu ułożenia w LocalStorage
        function saveDraftState() {
            const draft = {};
            slots.forEach(slot => {
                const slotIndex = slot.dataset.slot;
                const chip = slot.querySelector('.player-chip');
                if (chip) {
                    draft[slotIndex] = chip.dataset.id;
                }
            });
            localStorage.setItem(STORAGE_KEY, JSON.stringify(draft));
        }

        // Przywrócenie stanu ułożenia po wejściu / powrocie na podstronę
        function restoreDraftState() {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (!saved) return;

            try {
                const draft = JSON.parse(saved);
                Object.keys(draft).forEach(slotNum => {
                    const playerId = draft[slotNum];
                    const targetSlot = document.querySelector(`.slot-box[data-slot="${slotNum}"] .slot-target`);
                    const chip = document.querySelector(`.player-chip[data-id="${playerId}"]`);

                    if (targetSlot && chip) {
                        targetSlot.appendChild(chip);
                    }
                });
            } catch (err) {
                console.error("Błąd odczytu zapisanego rankingu:", err);
            }
            updateCounter();
        }

        function showWarning(message) {
            modalMsg.innerText = message;
            modal.style.display = 'flex';
        }

        closeModalBtn.addEventListener('click', () => {
            modal.style.display = 'none';
        });

        modal.addEventListener('click', (e) => {
            if (e.target === modal) modal.style.display = 'none';
        });

        function attachChipEvents(chip) {
            chip.addEventListener('dragstart', (e) => {
                draggedChip = chip;
                chip.classList.add('dragging');
                e.dataTransfer.setData('text/plain', chip.dataset.id);
            });

            chip.addEventListener('dragend', () => {
                chip.classList.remove('dragging');
                draggedChip = null;
            });

            // Kliknięcie przenosi między slotem a pulą
            chip.addEventListener('click', () => {
                if (chip.parentElement.classList.contains('slot-target')) {
                    pool.appendChild(chip);
                } else {
                    for (const slot of slots) {
                        const target = slot.querySelector('.slot-target');
                        if (target.children.length === 0) {
                            target.appendChild(chip);
                            break;
                        }
                    }
                }
                updateCounter();
            });
        }

        document.querySelectorAll('.player-chip').forEach(attachChipEvents);

        slots.forEach(slot => {
            const target = slot.querySelector('.slot-target');

            slot.addEventListener('dragover', (e) => {
                e.preventDefault();
                slot.classList.add('drag-over');
            });

            slot.addEventListener('dragleave', () => {
                slot.classList.remove('drag-over');
            });

            slot.addEventListener('drop', (e) => {
                e.preventDefault();
                slot.classList.remove('drag-over');
                if (draggedChip) {
                    if (target.children.length > 0) {
                        pool.appendChild(target.children[0]);
                    }
                    target.appendChild(draggedChip);
                    updateCounter();
                }
            });
        });

        pool.addEventListener('dragover', (e) => e.preventDefault());
        pool.addEventListener('drop', (e) => {
            e.preventDefault();
            if (draggedChip) {
                pool.appendChild(draggedChip);
                updateCounter();
            }
        });

        // Resetowanie draftu
        resetBtn.addEventListener('click', () => {
            document.querySelectorAll('.slot-target .player-chip').forEach(chip => {
                pool.appendChild(chip);
            });
            localStorage.removeItem(STORAGE_KEY);
            updateCounter();
        });

        // Wysłanie gotowego formularza
        form.addEventListener('submit', (e) => {
            const order = [];
            slots.forEach(slot => {
                const chip = slot.querySelector('.player-chip');
                if (chip) {
                    order.push(parseInt(chip.dataset.id, 10));
                }
            });

            if (order.length < 30) {
                e.preventDefault();
                const missing = 30 - order.length;
                showWarning(`You have placed ${order.length} players. You still need to place ${missing} more player${missing > 1 ? 's' : ''} to complete your official Ballon d'Or ballot!`);
                return;
            }

            rankingInput.value = JSON.stringify(order);
            // Po zatwierdzeniu czyścimy wersję roboczą
            localStorage.removeItem(STORAGE_KEY);
        });

        // Odtwórz stan po odświeżeniu lub cofnięciu ze strony piłkarza
        restoreDraftState();
    </script>
</body>
</html>